{
  "name": "hexdailydata-paid-api-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated paid API foundation with synthetic payment adapters",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "test:starter": "node --test tests/starter.test.mjs",
    "preflight": "node tools/preflight.mjs",
    "test": "node tools/runtime.mjs test",
    "dev": "node tools/runtime.mjs start",
    "build": "tsc && tsc -p tsconfig.ui.json && vite build",
    "package:source": "node tools/package-source.mjs",
    "lab:stop": "node tools/runtime.mjs stop"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "better-auth": "1.7.5",
    "fastify": "5.12.5",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
