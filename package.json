{
  "name": "hexdailydata-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HEXDailyData v2 development foundation; live sync not implemented",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "test": "node scripts/test.mjs",
    "task": "node scripts/task.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch src/api/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/api/main.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node scripts/doctor.mjs",
    "worker:status": "node src/worker/main.ts status",
    "test:containers": "node scripts/test-containers.mjs",
    "test:browser": "node --test tests/browser/shell.test.mjs",
    "db:migrate": "node src/db/main.ts migrate",
    "test:sql": "node scripts/test-sql.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:daily": "node scripts/test-daily.mjs",
    "test:api": "node scripts/test-api.mjs",
    "openapi": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@noble/hashes": "2.0.1",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
