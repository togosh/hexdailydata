# Starter is deliberately non-live. No existing v1 credentials are loaded.
HDD_V2_MODE=scaffold
HDD_V2_HTTP_HOST=127.0.0.1
HDD_V2_HTTP_PORT=4320
HDD_V2_ALLOW_LIVE_RPC=false
# Task01/02 supplies isolated roles/config. Do not reuse a host "hexstake" database.
HDD_V2_DATABASE_URL=
HDD_V2_PULSECHAIN_RPC_PRIMARY=
HDD_V2_PULSECHAIN_RPC_SECONDARY=
HDD_V2_ETHEREUM_ARCHIVE_RPC=
# Must be supplied before starting the optional scaffold DB container.
HDD_V2_POSTGRES_PASSWORD=
