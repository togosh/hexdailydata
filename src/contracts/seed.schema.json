{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "calculationVersion": {
      "type": "string",
      "const": "hex-native-1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "chainId": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 369
        }
      ]
    },
    "contractAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "codeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "blockNumber": {
          "type": "string",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "blockTime": {
          "type": "string",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "revision": {
          "type": "string",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "rewindFloor": {
          "type": "string",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "finality": {
          "type": "string",
          "enum": [
            "confirmed",
            "finalized"
          ]
        }
      },
      "required": [
        "blockNumber",
        "blockHash",
        "blockTime",
        "revision",
        "rewindFloor",
        "finality"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parentChainId": {
          "type": "number",
          "const": 1
        },
        "parentBlockNumber": {
          "type": "string",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "parentBlockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "firstNativeBlockNumber": {
          "type": "string",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "firstNativeBlockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      },
      "required": [
        "parentChainId",
        "parentBlockNumber",
        "parentBlockHash",
        "firstNativeBlockNumber",
        "firstNativeBlockHash"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string",
            "enum": [
              "ethereum-native",
              "pulsechain-native",
              "market"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "missing"
            ]
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 78,
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 78,
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "dataset",
          "status",
          "from",
          "to",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "minItems": 14,
      "maxItems": 14,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "enum": [
              "chains",
              "source_history",
              "sync_state",
              "current_state",
              "accounts",
              "stakes",
              "share_schedule",
              "daily_stats",
              "blocks_recent",
              "events",
              "transfers_recent",
              "checkpoints_recent",
              "undo_recent",
              "recovery_pins"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^tables\\/[a-z_]+\\.ndjson$"
          },
          "rows": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "bytes": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "table",
          "path",
          "rows",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "schemaVersion",
    "calculationVersion",
    "createdAt",
    "chainId",
    "contractAddress",
    "codeSha256",
    "checkpoint",
    "coverage",
    "files"
  ],
  "additionalProperties": false
}
