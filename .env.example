# Optional development values; programs do not automatically load this file.
HDD_V2_MODE=development
HDD_V2_HTTP_HOST=127.0.0.1
HDD_V2_HTTP_PORT=4320
HDD_V2_ALLOW_LIVE_RPC=false
# Set a unique v2-specific project name for every disposable Compose run.
HDD_V2_PROJECT=
HDD_V2_HOST_PORT=4320
# Optional new disposable PostgreSQL container only; never reuse a v1 password.
HDD_V2_POSTGRES_PASSWORD=
