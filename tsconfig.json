{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/contracts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts"
  ]
}
